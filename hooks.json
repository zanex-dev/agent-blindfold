{
  "agent-blindfold": {
    "SessionStart": [
      {
        "type": "command",
        "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/session_start.ps1",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|read_resource|write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|generate_image|run_command|call_mcp_tool|mcp_.*|Read|View|NotebookRead|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./scripts/guard.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
