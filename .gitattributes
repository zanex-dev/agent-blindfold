# Normalize line endings across platforms so shell scripts never break with CRLF
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
